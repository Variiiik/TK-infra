# ============================================================
# TAKE CONTROL - Environment Configuration Example
# Copy to .env and fill in your values
# ============================================================

# Application
NODE_ENV=development
APP_NAME="TakeControl"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WS_URL=ws://localhost:4000

# Backend Server
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# Frontend
FRONTEND_PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://takecontrol:password@localhost:5432/takecontrol_db?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=takecontrol_db
DB_USER=takecontrol
DB_PASSWORD=change_me_in_production

# Redis (Session store, pub/sub)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256 for session data)
ENCRYPTION_KEY=32-char-encryption-key-change-me!
ENCRYPTION_IV=16-char-iv-change!

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=100
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="TakeControl <noreply@takecontrol.app>"

# WebRTC / TURN Server
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=turnuser
TURN_CREDENTIAL=turnpassword
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Admin
ADMIN_EMAIL=admin@takecontrol.app
ADMIN_PASSWORD=Admin@123456!

# Multi-tenant
DEFAULT_ORG_NAME="Default Organization"
DEFAULT_ORG_SLUG=default

# Feature Flags
FEATURE_CHAT=true
FEATURE_FILE_TRANSFER=true
FEATURE_RECORDING=true
FEATURE_MULTI_MONITOR=true

# Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090

# SSL (production)
SSL_CERT_PATH=
SSL_KEY_PATH=
